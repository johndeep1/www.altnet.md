generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://Main_owner:MxJ9VjDPRG1g@ep-dry-smoke-a2zsew4y.eu-central-1.aws.neon.tech/altnet?sslmode=require"
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal
  sku         String   @unique
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  brand       String
  model       String?
  specs       Json?    // For storing technical specifications
  images      String[] // URLs to product images
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

enum ProductStatus {
  ACTIVE
  OUTOFSTOCK
  DISCONTINUED
  COMINGSOON
}

// For tracking price history
model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Decimal
  date      DateTime @default(now())

  @@index([productId])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
} 